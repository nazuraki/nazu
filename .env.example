# Database
DATABASE_URL=postgresql://nazu:password@localhost:5432/nazu
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...

# MinIO (object storage for documents)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nazu-documents

# ── Compose / service control ───────────────────────────────────────────
# Pinned so the web app's in-container `docker compose` targets the same
# project/network as the host. Keep in sync with the host project name.
COMPOSE_PROJECT_NAME=nazu
# Absolute host dir for generated config (e.g. the Caddyfile). Mirrored into
# the web (rw) and caddy (ro) containers at the same path.
NAZU_CONFIG_DIR=/srv/nazu

# ── Caddy (tls profile) ─────────────────────────────────────────────────
# Required before enabling the tls service (UI toggle or `--profile tls up`).
# NAZU_TLS_CERT/KEY are absolute host paths, bind-mounted into caddy at the
# same path. Caddy fails to start if any of these are unset.
NAZU_HOSTNAME=your.host.example
NAZU_TLS_CERT=/etc/ssl/nazu/your-host.pem
NAZU_TLS_KEY=/etc/ssl/nazu/your-host-key.pem

# ── Cloudflare Tunnel (tunnel profile) ──────────────────────────────────
# Required before enabling the tunnel service. From the CF dashboard
# "Install connector" page.
CF_TUNNEL_TOKEN=
