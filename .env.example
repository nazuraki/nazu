# Database
DATABASE_URL=postgresql://nazu:password@localhost:5432/nazu
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...

# MinIO (object storage for documents)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nazu-documents

# ── Caddy (tls profile) ─────────────────────────────────────────────────
# Required when running `docker compose --profile tls up`. Caddy fails to
# start if any of these are unset.
NAZU_HOSTNAME=your.host.example
NAZU_TLS_CERT=/certs/your-host.pem
NAZU_TLS_KEY=/certs/your-host-key.pem
